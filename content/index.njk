---
title: "Home"
description: "The unified national voice of local governments in Pakistan."
extraScripts:
  - "/script.js"
---
<section class="hero">
  <!-- Left Side: Content -->
  <div class="hero-left">
    <h1>UNITING LOCAL VOICES, <span>EMPOWERING COMMUNITIES.</span></h1>
    <p>
      The Association for Development of Local Governance (ADLG) represents all 
      provincial, Azad Jammu &amp; Kashmir, and Gilgit-Baltistan Local Councils Associations. 
      We bridge local communities and decision-makers to build inclusive, self-sustaining local democracy.
    </p>
    <div class="btn-row">
      <a href="/regional-alliance/" class="btn btn-primary">Explore Regional Alliance</a>
    </div>
  </div>

  <!-- Right Side: Logo/Graphic -->
  <div class="hero-right">
    <img 
      src="/assets/logos/MAP_LCAS_q90.png" 
      alt="ADLG network of Local Councils Associations across Pakistan"
      class="hero-logo"
    />
  </div>
</section>
<!-- Wrap in <section class="section"> so it centers & constrains max-width -->
<section class="section">
  <h2>Latest News &amp; Events</h2>
  <div class="news-toolbar" aria-label="Filter latest news and events">
    <label for="home-news-date">Date:</label>
    <select id="home-news-date">
      <option value="all">All recent dates</option>
      {% for post in collections.newsPosts.slice(0, 6) %}
        <option value="{{ post.date | date }}">{{ post.date | date }}</option>
      {% endfor %}
    </select>
  </div>

  <div class="news-grid" id="home-news-grid">
    {% for post in collections.newsPosts.slice(0, 6) %}
      <a href="{{ post.url }}" class="news-card" data-news-date="{{ post.date | date }}">
        {% if post.data.featuredImage %}
          <img class="news-card-media" src="{{ post.data.featuredImage }}" alt="{{ post.data.featuredImageAlt or post.data.title }}" loading="lazy">
        {% endif %}
        <span class="tag">{{ post.data.tag }}</span>
        <h4>{{ post.data.title }}</h4>
        <p>{{ post.data.excerpt }}</p>
        <time class="news-card-date" datetime="{{ post.date | date }}">{{ post.date | date }}</time>
      </a>
    {% else %}
      <p class="news-empty">No news or events have been published yet.</p>
    {% endfor %}
  </div>
  <p id="home-news-empty" class="news-empty" hidden>No items match this date.</p>
  <p style="text-align:center;margin-top:24px;">
    <a href="/news/" class="btn btn-navy">View All News &amp; Events</a>
  </p>
</section>
<script>
(function(){
  const select = document.getElementById('home-news-date');
  const grid = document.getElementById('home-news-grid');
  const empty = document.getElementById('home-news-empty');
  if(!select || !grid) return;
  select.addEventListener('change', function(){
    const cards = Array.from(grid.querySelectorAll('.news-card'));
    let visible = 0;
    cards.forEach(function(card){
      const show = this.value === 'all' || card.dataset.newsDate === this.value;
      card.hidden = !show;
      if(show) visible++;
    }, this);
    if(empty) empty.hidden = visible !== 0;
  });
})();
</script>
<section class="section">
<h2>LCA TV — Latest Videos</h2>
<div class="video-grid" id="video-grid" data-limit="3" data-more-link="/resources/"></div>
