<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>{{ title }} | LCAs - Local Councils Associations of Pakistan</title>

<meta name="description" content="{{ description }}">

<link rel="icon" type="image/png" href="/assets/logos/header-logo.png">
<link rel="stylesheet" href="/style.css">

{% if ogImage %}
<meta property="og:image" content="{{ ogImage }}">
{% endif %}

<meta property="og:title" content="{{ title }} | LCAs of Pakistan">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="website">

<meta name="twitter:card" content="summary_large_image">

<script>
(function () {
  var hash = window.location.hash;

  if (
    hash &&
    (
      hash.includes('invite_token') ||
      hash.includes('recovery_token') ||
      hash.includes('confirmation_token') ||
      hash.includes('email_change_token')
    )
  ) {
    window.location.replace('/admin/' + hash);
  }
})();
</script>

</head>

<body>

<div class="topbar">
  <span>SECP Registered Non-Profit Organisation</span>
  <span>Pakistan Zindabad</span>
</div>


<nav class="nav" aria-label="Primary navigation">

  <a href="/" class="logo-link">
    <img
      src="/assets/logos/header-logo.png"
      alt="Local Councils Associations of Pakistan"
      class="header-logo"
    >
    <span class="logo">LCAs of Pakistan</span>
  </a>


  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-menu"
    aria-label="Open menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>


  <div class="nav-menu" id="primary-menu">

    <div class="nav-links">

      {% for item in nav.items %}

        {# Find CMS pages whose parent matches this menu item #}

        {% set children = [] %}

        {% for child in collections.navigationPages %}

          {% if child.data.parent == item.label %}

            {% set children = children.concat([child]) %}

          {% endif %}

        {% endfor %}


        {% if children.length > 0 %}

          <div class="nav-dropdown">

            <div class="nav-dropdown-main">

              <a
                href="{{ item.url }}"
                {% if item.url == page.url %}class="active"{% endif %}
              >
                {{ item.label }}
              </a>

              <button
                class="dropdown-toggle"
                type="button"
                aria-expanded="false"
                aria-label="Open {{ item.label }} submenu"
              >
                <span>▾</span>
              </button>

            </div>


            <div class="dropdown-menu">

              {% for child in children %}

                <a
                  href="{{ child.url }}"
                  {% if child.url == page.url %}class="active"{% endif %}
                >
                  {{ child.data.menuLabel or child.data.title }}
                </a>

              {% endfor %}

            </div>

          </div>


        {% else %}

          <a
            href="{{ item.url }}"
            {% if item.url == page.url %}class="active"{% endif %}
          >
            {{ item.label }}
          </a>

        {% endif %}

      {% endfor %}

    </div>


    <a
      href="https://www.youtube.com/@LCATVPAKISTAN"
      target="_blank"
      rel="noopener"
      class="nav-cta"
    >
      Watch LCA TV ▶
    </a>

  </div>

</nav>


{{ content | safe }}


